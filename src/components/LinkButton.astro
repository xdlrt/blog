---
export interface Props {
  href: string;
  className?: string;
  ariaLabel?: string;
  ariaCurrent?: "page";
  title?: string;
  disabled?: boolean;
}

const {
  href,
  className = "",
  ariaLabel,
  ariaCurrent,
  title,
  disabled = false,
} = Astro.props;
---

{
  disabled ? (
    <span
      class={`group ${className}`}
      aria-label={ariaLabel}
      aria-current={ariaCurrent}
      title={title}
      aria-disabled="true"
    >
      <slot />
    </span>
  ) : (
    <a
      href={href}
      class={`group ${className}`}
      aria-label={ariaLabel}
      aria-current={ariaCurrent}
      title={title}
    >
      <slot />
    </a>
  )
}

<style>
  @reference "../styles/base.css";

  a,
  span {
    @apply hover:text-skin-accent transition-all;
  }
  span[aria-disabled="true"] {
    @apply pointer-events-none select-none text-skin-muted;
  }
</style>
