---
export interface Props {
  width?: "wide" | "reading";
}

const { width = "wide" } = Astro.props;

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

const pathMap: Record<string, string> = {
  posts: "文章",
  tags: "标签",
  about: "关于我",
  search: "搜索",
};

const linkMap: Record<string, string> = {
  标签: "tags",
};

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath
  .split("/")
  .slice(1)
  .map(path => {
    return decodeURIComponent(pathMap[path] || path);
  });

breadcrumbList[0] === "文章" && breadcrumbList.splice(0, 2, `文章`);
---

<nav
  class={`breadcrumb ${width === "reading" ? "reading" : "wide"}`}
  aria-label="面包屑"
>
  <ul>
    <li>
      <a href="/">首页</a>
      <span aria-hidden="true">&nbsp;&#62;&nbsp;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class={`${index > 0 ? "lowercase" : "capitalize"}`}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {breadcrumb}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${linkMap[breadcrumb]}`}>{breadcrumb}</a>
            <span aria-hidden="true">&nbsp;&#62;&nbsp;</span>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  @reference "../styles/base.css";

  .breadcrumb {
    @apply mx-auto mt-8 mb-1 w-full px-4 text-sm text-skin-muted;
  }
  .breadcrumb.wide {
    @apply max-w-5xl;
  }
  .breadcrumb.reading {
    max-width: calc(var(--layout-reading-width) + 2rem);
  }
  .breadcrumb ul li {
    @apply inline;
  }
  .breadcrumb ul li a {
    @apply capitalize transition-all;
  }
  .breadcrumb ul li span {
    @apply text-skin-muted;
  }
  .breadcrumb ul li:not(:last-child) a {
    @apply hover:opacity-100;
  }

  @media (min-width: 1600px) {
    .breadcrumb.wide {
      max-width: var(--layout-display-width);
    }
  }
</style>
