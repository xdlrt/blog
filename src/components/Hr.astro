---
export interface Props {
  noPadding?: boolean;
}

const { noPadding = false } = Astro.props;
---

<div
  class={`section-break max-w-5xl mx-auto ${noPadding ? "px-0" : "px-4"}`}
  aria-hidden="true"
>
</div>

<style>
  .section-break {
    min-height: 0.5rem;
  }

  @media (min-width: 1600px) {
    .section-break {
      max-width: var(--layout-display-width);
    }
  }
</style>
