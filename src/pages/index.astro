---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import { getSortedPosts } from "@utils/getSortedPosts";
import { slugify } from "@utils/slugify";
import { SOCIALS } from "@config";
import { getPublishPosts } from "@utils/getPosts";

const posts = await getPublishPosts();

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts;

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-copy">
        <div class="eyebrow">
          <span>IN PROGRESS TO BE A PRODUCT MAKER</span>
          <span>EST. 2016</span>
        </div>
        <h1><span>技术向前，</span><span>生活向内。</span></h1>
        <p class="hero-intro">
          你好，我是小树。这里记录产品、技术与生活选择，
          也保存那些值得反复回看的思考。
        </p>
        <div class="hero-actions">
          <a href="/posts" class="primary-action"> 开始阅读 </a>
          <LinkButton className="about-link" href="/about">关于我</LinkButton>
        </div>
        {
          socialCount > 0 && (
            <div class="social-wrapper">
              <div class="social-links">FIND ME ELSEWHERE</div>
              <Socials />
            </div>
          )
        }
      </div>
      <aside class="archive-note" aria-label="博客写作档案概览">
        <p class="note-label">WRITING ARCHIVE</p>
        <p class="note-count">{sortedPosts.length}<span>篇</span></p>
        <p class="note-copy">
          从技术学习到产品思考，也记录工作与生活中那些具体的选择。
        </p>
        <div class="note-meta">
          <span>始于 2016</span>
          <span>持续更新</span>
        </div>
      </aside>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <div class="section-heading">
              <div>
                <span class="section-index">CURATED / 01</span>
                <h2>精选文章</h2>
              </div>
              <p>一些经得住时间回看的文字</p>
            </div>
            <ul>
              {featuredPosts.map(({ data }, index) => (
                <Card
                  href={`/posts/${slugify(data)}`}
                  frontmatter={data}
                  secHeading={false}
                  index={index + 1}
                  variant={index === 0 ? "lead" : "editorial"}
                />
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }

    <section id="recent-posts">
      <div class="section-heading">
        <div>
          <span class="section-index">ARCHIVE / {sortedPosts.length}</span>
          <h2>最近文章</h2>
        </div>
        <p>沿着时间，查看最近留下的记录</p>
      </div>
      <ul class="article-grid">
        {
          recentPosts.map(
            ({ data }, index) =>
              index < 6 && (
                <Card
                  href={`/posts/${slugify(data)}`}
                  frontmatter={data}
                  secHeading={false}
                  index={index + 1}
                  variant={index === 0 ? "lead" : "editorial"}
                />
              )
          )
        }
      </ul>
      <div class="all-posts-btn-wrapper">
        <LinkButton href="/posts">
          <span class="all-posts-text">查看完整写作档案</span>
        </LinkButton>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #hero {
    @apply grid px-4 py-14;
    max-width: 64rem;
    min-height: min(610px, calc(100vh - 110px));
    grid-template-columns: minmax(0, 1.45fr) minmax(14rem, 0.55fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }
  .hero-copy {
    max-width: 46rem;
  }
  .eyebrow {
    @apply mb-8 flex items-center justify-between gap-4 text-[0.68rem] font-semibold tracking-[0.16em] text-skin-muted;
  }
  #hero h1 {
    font-size: clamp(3rem, 7.8vw, 6rem);
    line-height: 1.02;
    @apply my-0 font-semibold;
  }
  #hero h1 span {
    @apply block;
  }
  #hero h1 span:last-child {
    color: rgb(var(--color-accent));
  }
  .hero-intro {
    max-width: 35rem;
    @apply mt-8 text-base leading-8 text-skin-muted sm:text-lg;
  }
  .hero-actions {
    @apply mt-9 flex items-center gap-7;
  }
  .primary-action {
    @apply inline-flex items-center rounded-full bg-skin-base px-6 py-3 text-sm font-medium text-skin-fill transition-transform duration-300;
  }
  .primary-action:hover {
    transform: translateY(-2px);
  }
  .hero-actions :global(.about-link) {
    @apply text-sm underline underline-offset-8;
  }
  .social-wrapper {
    @apply mt-14 flex items-center gap-3;
  }
  .social-links {
    @apply whitespace-nowrap text-[0.68rem] tracking-[0.16em] text-skin-muted;
  }
  .archive-note {
    @apply relative rounded-[2rem] bg-skin-card/85 p-8;
  }
  .note-label {
    @apply text-[0.68rem] font-semibold tracking-[0.18em] text-skin-muted;
  }
  .note-count {
    font-family: "Songti SC", STSong, serif;
    @apply mt-7 text-6xl font-semibold leading-none text-skin-accent;
  }
  .note-count span {
    @apply ml-2 text-base font-normal text-skin-muted;
  }
  .note-copy {
    @apply mt-6 text-sm leading-7 text-skin-muted;
  }
  .note-meta {
    @apply mt-8 flex justify-between text-[0.68rem] tracking-wider text-skin-muted;
  }
  #featured,
  #recent-posts {
    @apply px-4 pb-12 pt-14;
    max-width: 64rem;
  }
  .section-heading {
    @apply mb-10 flex items-end justify-between gap-8;
  }
  .section-index {
    color: rgb(var(--color-accent));
    @apply text-[0.65rem] font-semibold tracking-[0.18em];
  }
  .section-heading h2 {
    @apply mt-2 text-3xl font-semibold sm:text-4xl;
  }
  .section-heading p {
    @apply hidden max-w-xs text-right text-sm text-skin-muted sm:block;
  }
  .article-grid,
  #featured ul {
    @apply grid grid-cols-2 gap-x-5 gap-y-3;
  }
  .article-grid :global(.article-card-lead),
  #featured :global(.article-card-lead) {
    @apply col-span-2 bg-skin-card/45;
  }
  .article-grid :global(.article-card-lead > a),
  #featured :global(.article-card-lead > a) {
    @apply px-7 py-9;
  }
  .article-grid :global(.article-card-lead .card-title),
  #featured :global(.article-card-lead .card-title) {
    font-size: clamp(1.8rem, 4vw, 3rem);
  }
  .all-posts-btn-wrapper {
    @apply my-12 text-center;
  }
  .all-posts-text {
    @apply inline-block align-middle;
  }
  @media (max-width: 720px) {
    #hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 3rem;
      padding-bottom: 3.5rem;
    }
    .eyebrow span:first-child {
      max-width: 14rem;
    }
    .archive-note {
      display: none;
    }
    .social-wrapper {
      @apply mt-10 flex-col items-start;
    }
    .article-grid,
    #featured ul {
      grid-template-columns: 1fr;
    }
    .article-grid :global(.article-card-lead),
    #featured :global(.article-card-lead) {
      grid-column: span 1;
    }
  }
</style>
