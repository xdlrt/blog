---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import { getSortedPosts } from "@utils/getSortedPosts";
import { slugify } from "@utils/slugify";
import { SOCIALS } from "@config";
import { getPublishPosts } from "@utils/getPosts";

const posts = await getPublishPosts();

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts;

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-heading">
        <p class="eyebrow">IN PROGRESS TO BE A PRODUCT MAKER</p>
        <h1><span>技术向前，</span><span>生活向内。</span></h1>
      </div>
      <aside class="archive-note" aria-label="博客写作档案概览">
        <p class="note-count">
          <strong>{sortedPosts.length}</strong><span>篇文章</span>
        </p>
        <div class="note-meta">
          <span>始于 2016</span>
          <span>持续更新</span>
        </div>
      </aside>
      <div class="hero-actions">
        <a href="/posts" class="primary-action">开始阅读</a>
        <LinkButton className="about-link" href="/about">关于我</LinkButton>
      </div>
      {
        socialCount > 0 && (
          <div class="social-wrapper" aria-label="外部链接">
            <Socials variant="text" />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <div class="section-heading">
              <div>
                <span class="section-index">CURATED / 01</span>
                <h2>精选文章</h2>
              </div>
              <p>一些经得住时间回看的文字</p>
            </div>
            <ul>
              {featuredPosts.map(({ data }, index) => (
                <Card
                  href={`/posts/${slugify(data)}`}
                  frontmatter={data}
                  secHeading={false}
                  index={index + 1}
                  variant={index === 0 ? "lead" : "editorial"}
                />
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }

    <section id="recent-posts">
      <div class="section-heading">
        <div>
          <span class="section-index">ARCHIVE / {sortedPosts.length}</span>
          <h2>最近文章</h2>
        </div>
        <p>沿着时间，查看最近留下的记录</p>
      </div>
      <ul class="article-grid">
        {
          recentPosts.map(
            ({ data }, index) =>
              index < 6 && (
                <Card
                  href={`/posts/${slugify(data)}`}
                  frontmatter={data}
                  secHeading={false}
                  index={index + 1}
                  variant="editorial"
                />
              )
          )
        }
      </ul>
      <div class="all-posts-btn-wrapper">
        <LinkButton className="archive-action" href="/posts">
          <span class="all-posts-text">查看完整写作档案</span>
        </LinkButton>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #hero {
    @apply grid px-4;
    max-width: 64rem;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.34fr);
    grid-template-areas:
      "heading archive"
      "actions social";
    column-gap: clamp(3.5rem, 9vw, 8rem);
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: clamp(4.75rem, 10vh, 7rem);
    padding-bottom: clamp(5.5rem, 12vh, 8rem);
  }
  .hero-heading {
    grid-area: heading;
  }
  .eyebrow {
    @apply mb-8 text-[0.68rem] font-semibold tracking-[0.16em] text-skin-muted;
  }
  #hero h1 {
    font-size: clamp(3.5rem, 7.2vw, 5.75rem);
    line-height: 0.98;
    @apply my-0 font-semibold;
  }
  #hero h1 span {
    @apply block;
  }
  #hero h1 span:last-child {
    color: rgb(var(--color-accent));
  }
  .hero-actions {
    grid-area: actions;
    @apply flex items-center gap-7;
  }
  .primary-action {
    @apply inline-flex min-h-11 items-center rounded bg-skin-base px-6 text-sm font-medium text-skin-fill transition-colors duration-300;
  }
  .primary-action:hover {
    background-color: rgb(var(--color-accent));
  }
  .hero-actions :global(.about-link) {
    @apply inline-flex min-h-11 items-center text-sm underline underline-offset-8;
  }
  .social-wrapper {
    grid-area: social;
    @apply flex items-center;
  }
  .archive-note {
    grid-area: archive;
    align-self: end;
  }
  .note-count {
    font-family: "Songti SC", STSong, serif;
    @apply flex items-end gap-3 leading-none text-skin-accent;
  }
  .note-count strong {
    @apply text-6xl font-semibold;
  }
  .note-count span {
    font-family: inherit;
    @apply pb-1 text-sm font-normal tracking-[0.08em] text-skin-muted;
  }
  .note-meta {
    @apply mt-5 flex gap-7 text-[0.68rem] tracking-wider text-skin-muted;
  }
  .social-wrapper :global(.text-links) {
    @apply flex-nowrap gap-3;
  }
  .social-wrapper :global(.text-links a) {
    @apply rounded px-1 text-[0.68rem] font-medium uppercase tracking-[0.1em];
  }
  .social-wrapper :global(.text-links a:first-child) {
    @apply pl-0;
  }
  #featured,
  #recent-posts {
    @apply px-4 pb-12 pt-14;
    max-width: 64rem;
  }
  .section-heading {
    @apply mb-10 flex items-end justify-between gap-8;
  }
  .section-index {
    color: rgb(var(--color-accent));
    @apply text-[0.65rem] font-semibold tracking-[0.18em];
  }
  .section-heading h2 {
    @apply mt-2 text-3xl font-semibold sm:text-4xl;
  }
  .section-heading p {
    @apply hidden max-w-xs text-right text-sm text-skin-muted sm:block;
  }
  .article-grid,
  #featured ul {
    @apply grid grid-cols-2 gap-x-10 gap-y-3;
  }
  #featured :global(.article-card-lead) {
    @apply col-span-2;
  }
  #featured :global(.article-card-lead > a) {
    @apply bg-skin-card/45;
  }
  #featured :global(.article-card-lead > a:hover) {
    @apply bg-skin-card/55;
  }
  #featured :global(.article-card-lead .card-title) {
    font-size: clamp(1.8rem, 4vw, 3rem);
  }
  .all-posts-btn-wrapper {
    @apply my-14 flex justify-center;
  }
  .all-posts-btn-wrapper :global(.archive-action) {
    @apply inline-flex min-h-12 min-w-56 items-center justify-center rounded bg-skin-base px-8 text-sm font-medium tracking-[0.04em] text-skin-fill transition-colors hover:bg-skin-accent hover:text-skin-fill;
  }
  .all-posts-text {
    @apply inline-block align-middle;
  }
  @media (max-width: 767px) {
    #hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "archive"
        "actions"
        "social";
      row-gap: 0;
      padding-top: 3.75rem;
      padding-bottom: 4.5rem;
    }
    .eyebrow {
      max-width: 14rem;
      @apply mb-6 leading-5;
    }
    #hero h1 {
      font-size: clamp(3rem, 14vw, 4rem);
    }
    .archive-note {
      @apply mt-9;
    }
    .note-count strong {
      @apply text-4xl;
    }
    .note-meta {
      @apply mt-3;
    }
    .hero-actions {
      @apply mt-8;
    }
    .social-wrapper {
      @apply mt-5;
    }
    .article-grid,
    #featured ul {
      grid-template-columns: 1fr;
    }
    #featured :global(.article-card-lead) {
      grid-column: span 1;
    }
  }
  @media (min-width: 1600px) {
    #hero,
    #featured,
    #recent-posts {
      max-width: var(--layout-display-width, 64rem);
    }
  }
</style>
