---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content">
    <div class="not-found-wrapper">
      <h1 aria-label="404 Not Found">404</h1>
      <p>这一页没有被收进档案</p>
      <span class="hint">也许它换了名字，或者从未存在过。</span>
      <div class="actions">
        <LinkButton href="/" className="primary-action">回到首页</LinkButton>
        <LinkButton href="/search" className="secondary-action"
          >搜索文章</LinkButton
        >
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #main-content {
    @apply mx-auto flex max-w-3xl flex-1 items-center justify-center;
  }
  .not-found-wrapper {
    @apply mb-14 flex max-w-xl flex-col items-center justify-center px-4 text-center;
  }
  .not-found-wrapper h1 {
    @apply text-9xl font-bold text-skin-accent;
  }
  .not-found-wrapper p {
    @apply mt-4 text-2xl sm:text-3xl;
  }
  .hint {
    @apply mt-3 text-sm text-skin-muted;
  }
  .actions {
    @apply mt-8 flex flex-wrap items-center justify-center gap-4;
  }
  .actions :global(.primary-action) {
    @apply rounded-full bg-skin-base px-5 py-3 text-sm font-semibold text-skin-fill;
  }
  .actions :global(.secondary-action) {
    @apply rounded-full bg-skin-card px-5 py-3 text-sm font-semibold;
  }
</style>
