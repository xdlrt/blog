---
import Breadcrumbs from "@components/Breadcrumbs.astro";

export interface Props {
  pageTitle?: string;
  pageDesc?: string;
  pageMeta?: string;
}

const { pageTitle, pageDesc, pageMeta } = Astro.props;
---

<Breadcrumbs />
<main id="main-content">
  {pageMeta && <p class="page-meta">{pageMeta}</p>}
  {pageTitle && <h1>{pageTitle}</h1>}
  {pageDesc && <p>{pageDesc}</p>}
  <slot />
</main>

<style>
  @reference "../styles/base.css";

  #main-content {
    @apply mx-auto w-full max-w-5xl px-4 pb-12 pt-10;
  }
  #main-content h1 {
    @apply text-3xl font-semibold sm:text-5xl;
  }
  #main-content .page-meta {
    @apply mb-2 mt-0 text-xs font-semibold tracking-[0.16em] text-skin-accent;
  }
  #main-content p {
    @apply mb-8 mt-3 text-skin-muted;
  }
</style>
