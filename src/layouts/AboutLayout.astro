---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter.title || "关于我";
---

<Layout title={`关于我 | ${SITE.title}`}>
  <Header activeNav="about" />
  <Breadcrumbs width="reading" />
  <main id="main-content">
    <header class="about-header">
      <p>ABOUT / YESHU</p>
      <h1>{title}</h1>
      {
        frontmatter.description && (
          <div class="about-deck">{frontmatter.description}</div>
        )
      }
    </header>
    <section id="about" class="prose mb-28 prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #main-content {
    @apply mx-auto w-full px-4;
    max-width: calc(var(--layout-reading-width) + 2rem);
  }
  .about-header {
    @apply pb-8 pt-10;
  }
  .about-header p {
    @apply text-xs font-semibold tracking-[0.16em] text-skin-accent;
  }
  .about-header h1 {
    @apply mt-3 text-4xl font-semibold sm:text-6xl;
  }
  .about-deck {
    @apply mt-5 max-w-2xl text-lg leading-8 text-skin-muted;
  }
  #about {
    @apply mx-auto;
    max-width: var(--layout-reading-width);
  }
  @media (min-width: 48rem) {
    #about {
      font-size: 1.0625rem;
      line-height: 2rem;
    }
  }
</style>
