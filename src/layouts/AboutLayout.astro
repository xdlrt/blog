---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter.title || "关于我";
---

<Layout title={`关于我 | ${SITE.title}`}>
  <Header activeNav="about" />
  <main id="main-content">
    <header class="about-header">
      <p>ABOUT / YESHU</p>
      <h1>{title}</h1>
      {
        frontmatter.description && (
          <div class="about-deck">{frontmatter.description}</div>
        )
      }
    </header>
    <section id="about" class="prose mb-28 prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  #main-content {
    @apply mx-auto w-full px-4;
    max-width: calc(var(--layout-reading-width) + 2rem);
  }
  .about-header {
    @apply pb-8 pt-10;
  }
  .about-header p {
    @apply text-xs font-semibold tracking-[0.16em] text-skin-accent;
  }
  .about-header h1 {
    @apply mt-3 text-4xl font-semibold sm:text-6xl;
  }
  .about-deck {
    @apply mt-5 max-w-2xl text-lg leading-8 text-skin-muted;
  }
  #about {
    @apply mx-auto;
    max-width: var(--layout-reading-width);
    padding-inline: 0;
  }
  #about :global(h2) {
    margin-bottom: 1.25rem !important;
    margin-top: 3.75rem !important;
    font-size: clamp(1.75rem, 2.5vw, 2.125rem);
    line-height: 1.25;
  }
  #about :global(h2:first-child) {
    margin-top: 0 !important;
  }
  #about :global(h3) {
    margin-bottom: 0.6rem !important;
    margin-top: 0 !important;
    font-size: 1.25rem;
    line-height: 1.45;
  }
  #about > :global(ul:first-of-type) {
    display: grid;
    gap: 0.75rem 2rem;
    margin-block: 0;
    padding-left: 1.25rem;
  }
  #about > :global(ol) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 3rem;
    margin-block: 2rem 0;
    padding-left: 0;
    list-style: none;
    counter-reset: belief;
  }
  #about > :global(ol > li) {
    position: relative;
    margin: 0;
    padding-left: 2.75rem;
    counter-increment: belief;
  }
  #about > :global(ol > li::before) {
    position: absolute;
    top: 0.15rem;
    left: 0;
    color: rgb(var(--color-accent));
    content: counter(belief, decimal-leading-zero);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  #about > :global(ol > li > ul) {
    margin-block: 0;
    padding-left: 1.2rem;
  }
  #about > :global(ol > li > ul > li) {
    margin-block: 0.35rem;
  }
  @media (min-width: 48rem) {
    #about {
      font-size: 1.0625rem;
      line-height: 2rem;
    }
    #about > :global(ul:first-of-type) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #about > :global(ol) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
